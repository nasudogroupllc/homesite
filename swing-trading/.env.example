# =============================================================================
#  SECRETS FILE - EXAMPLE
# =============================================================================
#  Your REAL secrets live in:  /home/trader/alpaca-trading/.env
#  This file (.env.example) is just a template that shows what goes in there.
#
#  HOW TO USE:
#    1. Open your real file:   nano /home/trader/alpaca-trading/.env
#    2. Make sure the lines below exist (your Alpaca keys are probably already
#       there). Add any that are missing and fill in the values.
#    3. Save (Ctrl+O, Enter) and exit (Ctrl+X).
#
#  NEVER share this file or commit it to GitHub. It contains passwords.
# =============================================================================

# ---- Alpaca (you already have these) ----------------------------------------
# Paper-trading keys from https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
# Leave this as the paper URL. Do NOT change to live until you tell the system to.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- ThetaData Terminal (running locally on this VPS) ------------------------
THETADATA_BASE_URL=http://127.0.0.1:25510

# ---- Telegram (reuse your existing bot) --------------------------------------
# The bot token from @BotFather, and the chat id the bot should message.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ---- Optional: earnings calendar --------------------------------------------
# The system uses a free earnings source (Nasdaq) that needs no key.
# If you ever get a Financial Modeling Prep key, put it here to use that instead.
FMP_API_KEY=
